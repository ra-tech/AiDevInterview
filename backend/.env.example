# --- Server ---
PORT=4000
NODE_ENV=development
# The Vite frontend's origin — must match exactly for the auth cookie to work cross-origin in dev.
FRONTEND_URL="http://localhost:5173"

# --- Database (Neon / Supabase / any Postgres) ---
DATABASE_URL="postgresql://user:password@localhost:5432/devinterview?schema=public"

# --- Auth (JWT + httpOnly cookie — replaces NextAuth from the Next.js version) ---
JWT_SECRET="generate-with-openssl-rand-base64-32"

# --- AI Provider ---
# Which provider implementation to use: "anthropic", "gemini", "groq", or "mock" (zero-cost, no key needed).
AI_PROVIDER="groq"
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Gemini free tier covers the Flash model family. Get a key at aistudio.google.com/apikey.
# Uses the current @google/genai SDK. Free tier is rate-limited AND has a daily cap that can
# be as low as 20 requests/day per model on some free-tier projects — the app fails fast on
# quota errors instead of burning retries on them, but there's no getting around the limit.
GEMINI_API_KEY="AIza..."
GEMINI_MODEL="gemini-2.5-flash"

# Groq: fast inference, generous free tier, no credit card. Get a key at console.groq.com/keys.
# Model IDs change fairly often as Groq deprecates older ones — check console.groq.com/docs/models
# if you get a model_not_found error. Check console.groq.com/settings/limits for current rate limits.
GROQ_API_KEY="gsk_..."
GROQ_MODEL="openai/gpt-oss-120b"

# --- Coding challenges ---
# "mock" (default) never executes candidate code — heuristic pass/fail, safe for local dev,
# zero setup. "judge0" is a real executor via Judge0's HTTP API — see backend README for the
# three ways to configure JUDGE0_BASE_URL. Currently executes JavaScript, TypeScript, and
# Python end-to-end (see src/lib/coderunner/harness.js for why Java/C++ aren't wired up yet).
CODE_RUNNER="mock"
# JUDGE0_BASE_URL="https://ce.judge0.com"
# JUDGE0_API_KEY=""
